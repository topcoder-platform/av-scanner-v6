{
  "app": {
    "command": [
      "CMD-SHELL",
      "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))\""
    ],
    "interval": 30,
    "timeout": 5,
    "retries": 3,
    "startPeriod": 60
  },
  "filescanner": {
    "command": [
      "CMD-SHELL",
      "clamdscan --config-file=/etc/clamav/clamd.conf --ping=1"
    ],
    "interval": 30,
    "timeout": 5,
    "retries": 3,
    "startPeriod": 300
  }
}
