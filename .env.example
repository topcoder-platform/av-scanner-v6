# Application
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# Kafka consumer
KAFKA_URL=localhost:9092
KAFKA_CLIENT_ID=av-scanner-v6
KAFKA_GROUP_ID=file-scanner-processor
KAFKA_ORIGINATOR=file-scanner-processor
AVSCAN_TOPIC=avscan.action.scan
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_BYTES=10485760
KAFKA_MAX_WAIT_TIME_MS=500

# Optional Kafka TLS (inline PEM with escaped newlines or file paths)
KAFKA_CLIENT_CERT=
KAFKA_CLIENT_CERT_KEY=
KAFKA_CA_CERT=
# Optional verification override; setting it also enables TLS.
KAFKA_REJECT_UNAUTHORIZED=

# S3 and scan limits
AWS_REGION=us-east-1
MAX_SCAN_FILE_SIZE_BYTES=524288000
SCAN_CONCURRENCY=1
WHITELISTED_CLEAN_BUCKETS=
WHITELISTED_QUARANTINE_BUCKETS=
WHITELISTED_KAFKA_TOPICS=submission.scan.complete

# ClamAV (use filescanner in Compose and 127.0.0.1 in an ECS sidecar task)
CLAMAV_HOST=filescanner
CLAMAV_PORT=3310
CLAMAV_HEALTH_TIMEOUT_MS=2000
CLAMAV_SCAN_TIMEOUT_MS=300000

# Bus API callback and Auth0 client credentials
BUSAPI_EVENTS_URL=https://api.topcoder-dev.com/v5/bus/events
AUTH0_URL=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_PROXY_SERVER_URL=
TOKEN_CACHE_TIME=300

# Direct webhook delivery
WEBHOOK_TIMEOUT_MS=15000

# Optional Opsgenie alerts
OPSGENIE_ENABLED=false
OPSGENIE_API_URL=https://api.opsgenie.com/v2/alerts
OPSGENIE_API_KEY=
OPSGENIE_SOURCE=DevOps
