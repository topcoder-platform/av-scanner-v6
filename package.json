{
  "name": "av-scanner-v6",
  "version": "1.0.0",
  "description": "Topcoder submission antivirus scanner processor",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist/src/index.js",
    "start:dev": "tsx watch src/index.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dependency-compat": "node --test tools/minimatch-compat/index.test.cjs",
    "test:dead-letter-integration": "tsx test/dead-letter-kafka.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@platformatic/kafka": "2.8.0",
    "axios": "1.20.0",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/2067e74f73d7fe3442c96f375fc97f8486f79be4",
    "winston": "^3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
