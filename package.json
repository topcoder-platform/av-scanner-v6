{
  "name": "av-scanner-v6",
  "version": "1.0.0",
  "description": "Topcoder submission antivirus scanner processor",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist/src/index.js",
    "start:dev": "tsx watch src/index.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@platformatic/kafka": "2.8.0",
    "axios": "^1.12.0",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
